{
  "name": "jaew-guesthouse",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler d1 migrations apply DB --local && wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vite build && node --test tests/api.test.mjs",
    "import:railway": "node scripts/import-railway-backup.mjs",
    "compare": "node scripts/compare-sites.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "lucide-react": "0.546.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.14.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
