# Port the website runs on (default 3000)
PORT=3000

# Folder where all data is saved: settings, bookings, uploaded photos (default ./data)
# On a hosting service, point this at a PERSISTENT disk/volume or data is lost on redeploy.
DATA_DIR=./data

# Bookings are also pulled from the Jaew Logbook app. Set to empty to turn it off.
LOGBOOK_URL=https://jaewlogbook.ai.studio/api/bookings

# Which proxies may set the visitor's IP (used for the wrong-PIN lock-out).
# Default: 1 hop on Railway (detected automatically), otherwise only private-network proxies (Docker, local Caddy/Nginx).
# TRUST_PROXY=loopback, linklocal, uniquelocal
